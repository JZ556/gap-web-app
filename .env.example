# PostgreSQL connection string used by the server-side REST API.
# Never commit a real credential or production URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greyhound_adoption"

# Public origin used for local development and server-generated absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase client SDK values. These are public Firebase project identifiers,
# but keep real project values in .env.local for local development.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK values for server-side session and role checks.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
