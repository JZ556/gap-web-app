# Copy this file to .env.local for local development.
# Keep real secrets out of Git. Production values should be configured in the
# deployment platform's environment variable settings.

# Pooled Neon/PostgreSQL connection used by the running application.
# The pooled hostname normally contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB_NAME?sslmode=require"

# Direct Neon/PostgreSQL connection used by Prisma CLI migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require"

# Public origin used for local development and server-generated absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase client SDK values for the development Firebase project.
# These values are exposed to the browser by design, but keep real project
# values in .env.local or your deployment platform settings.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Firebase Admin SDK values from the downloaded service-account JSON.
# Keep the private key on one line and preserve each escaped \n sequence.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
